root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.py]
indent_size = 4

[*.toml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# FluentControl and GUI script exports are kept byte for byte as they came from the instrument
[{tests/fixtures/**,src/unitelabs/tecan_fluent/data/**}]
end_of_line = unset
charset = unset
trim_trailing_whitespace = false
insert_final_newline = unset
